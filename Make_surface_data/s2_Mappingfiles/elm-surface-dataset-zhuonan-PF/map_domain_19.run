#!/bin/bash
#SBATCH -t 4:00:00
#SBATCH -p batch
#SBATCH -A CLI185
#SBATCH -J map_19_domain
#SBATCH --nodes=1
#SBATCH --ntasks=16
#SBATCH -o %x-%j.out
#SBATCH -e %x-%j.err

# LUT source grid (NA 1/24°) -> small_SEUS_1_24deg. Run on compute nodes via sbatch.
# Submit: sbatch map_domain_19.run

set -euo pipefail

CDATE=cYYMMDD
module purge
module load Core/25.05
module load cmake/3.30.5
module load gcc/12.4.0
module load openmpi/5.0.5
module load netcdf-c/4.9.2-mpi-h5f
module load netcdf-fortran/4.6.1-mpi-h5f


srun   -n 16 \
ESMF_RegridWeightGen \
--ignore_unmapped \
-s /projects/hpcl-cli185/proj-shared/zw5/elm-surface-dataset/nlcd_NA_1_24deg_grids.nc \
-d /projects/hpcl-cli185/proj-shared/zw5/ELM_makeSurfdata/Make_surface_data/s1_Gridfiles/scr_out/SEUS_1_24deg_grids.nc \
--src_regional \
--dst_regional \
-m conserve \
-w map_nlcd_NA_1_24deg_to_HGRID_NAME_nomask_aave_da_${CDATE}.nc \
--src_type SCRIP \
--dst_type SCRIP \
--64bit_offset


mv *19.run done/
